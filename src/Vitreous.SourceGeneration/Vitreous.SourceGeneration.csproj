<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Vitreous.SourceGeneration</RootNamespace>
    <AssemblyName>Vitreous.SourceGeneration</AssemblyName>
    <Description>Roslyn source generator for Vitreous — zero-reflection handler dispatch and DI registration.</Description>
    <PackageTags>mediator;source-generator;roslyn</PackageTags>
    <IsPackable>true</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Source generators must not reference netstandard assemblies that conflict -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Suppress TreatWarningsAsErrors for netstandard2.0 nullable edge cases -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Don't inherit TreatWarningsAsErrors — generator warnings are advisory -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- RS2007: release tracking format is advisory for pre-release -->
    <NoWarn>RS2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
