<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Vitreous.SourceGeneration</RootNamespace>
    <AssemblyName>Vitreous.SourceGeneration</AssemblyName>
    <Description>Roslyn source generator for Vitreous — zero-reflection handler dispatch and DI registration.</Description>
    <PackageTags>mediator;source-generator;roslyn</PackageTags>
    <IsPackable>true</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Source generators must not reference netstandard assemblies that conflict -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Suppress TreatWarningsAsErrors for netstandard2.0 nullable edge cases -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Don't inherit TreatWarningsAsErrors — generator warnings are advisory -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- RS2007: release tracking format is advisory for pre-release -->
    <NoWarn>RS2007</NoWarn>

    <!--
      Analyzer packaging.
      A source generator must ship under analyzers/dotnet/cs — NOT under lib/ — otherwise
      the compiler never loads it and AddVitreousHandlers() is never generated.
      DevelopmentDependency marks the package as PrivateAssets="all" by default so it is
      never flowed to consumers of the user's project.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: no lib/ folder is expected for an analyzer package -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
