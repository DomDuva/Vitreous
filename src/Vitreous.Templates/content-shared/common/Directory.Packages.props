<Project>
  <!-- Central package management: every package version is set here, once for the solution. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vitreous.SourceGeneration and Vitreous must stay on the same version. -->
    <PackageVersion Include="Vitreous" Version="VITREOUS_VERSION" />
    <PackageVersion Include="Vitreous.SourceGeneration" Version="VITREOUS_VERSION" />
<!--#if (UseValidation) -->
    <PackageVersion Include="Vitreous.FluentValidation" Version="VITREOUS_VERSION" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
<!--#endif -->
<!--#if (caching == "memory") -->
    <PackageVersion Include="Vitreous.Caching" Version="VITREOUS_VERSION" />
<!--#elseif (caching == "redis") -->
    <PackageVersion Include="Vitreous.Caching.Redis" Version="VITREOUS_VERSION" />
<!--#endif -->
<!--#if (UseDevUI) -->
    <PackageVersion Include="Vitreous.DevUI" Version="VITREOUS_VERSION" />
<!--#endif -->
  </ItemGroup>
<!--#if (UseHost) -->

  <ItemGroup>
<!--#if (Framework == "net8.0") -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
<!--#elseif (Framework == "net9.0") -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.23" />
<!--#elseif (Framework == "net10.0") -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
<!--#else -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
<!--#endif -->
<!--#if (caching == "memory") -->
<!--#if (Framework == "net8.0") -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
<!--#elseif (Framework == "net9.0") -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.23" />
<!--#elseif (Framework == "net10.0") -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
<!--#else -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
<!--#endif -->
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseOpenApi) -->

  <ItemGroup>
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
<!--#if (Framework == "net8.0") -->
    <!-- Microsoft.AspNetCore.OpenApi generates documents from .NET 9 on; .NET 8 uses Swashbuckle. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
<!--#elseif (Framework == "net9.0") -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23" />
<!--#elseif (Framework == "net10.0") -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
<!--#else -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (tests) -->

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- mtp-off: runs under the classic dotnet test (VSTest) on every SDK from 8 to 11. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
<!--#if (!UseHost) -->
<!--#if (Framework == "net8.0") -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
<!--#elseif (Framework == "net9.0") -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.23" />
<!--#elseif (Framework == "net10.0") -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
<!--#else -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
<!--#endif -->
<!--#endif -->
<!--#if (UseFakeTime) -->
<!--#if (Framework == "net8.0") -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
<!--#elseif (Framework == "net9.0") -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
<!--#elseif (Framework == "net10.0") -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
<!--#else -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
<!--#endif -->
<!--#endif -->
  </ItemGroup>
<!--#endif -->
</Project>
