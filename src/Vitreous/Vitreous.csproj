<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vitreous</RootNamespace>
    <AssemblyName>Vitreous</AssemblyName>
    <Description>A high-performance, source-generated in-process mediator for .NET 10 with a first-class Result type.</Description>
    <PackageTags>mediator;cqrs;result;dispatcher</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
