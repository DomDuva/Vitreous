<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Vitreous</RootNamespace>
    <AssemblyName>Vitreous</AssemblyName>
    <Description>A high-performance, source-generated in-process mediator for .NET with a first-class Result type.</Description>
    <PackageTags>mediator;cqrs;result;dispatcher;source-generator;aot</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
