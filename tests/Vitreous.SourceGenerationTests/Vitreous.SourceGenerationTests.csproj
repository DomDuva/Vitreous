<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VitreousTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Vitreous.SourceGenerationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference Vitreous so that typeof(Vitreous.Abstractions.ICommand<>) is available at runtime,
      letting us pass the assembly as a metadata reference to in-memory test compilations.
    -->
    <ProjectReference Include="..\..\src\Vitreous\Vitreous.csproj" />
    <!--
      Reference the generator as a plain assembly (NOT as an Analyzer) so we can instantiate
      VitreousGenerator directly in tests. The generator does NOT run on this test project.
    -->
    <ProjectReference Include="..\..\src\Vitreous.SourceGeneration\Vitreous.SourceGeneration.csproj" />
  </ItemGroup>

  <!--
    The last Vitreous release before DispatchTelemetry (0.4.0). Generator output is compiled
    against it to check that a generator newer than Vitreous still produces code that builds.
  -->
  <ItemGroup>
    <PackageDownload Include="Vitreous" Version="[0.3.0]" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Vitreous030</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)vitreous/0.3.0/lib/net8.0/Vitreous.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
