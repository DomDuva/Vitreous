---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a href="https://www.nuget.org/packages/Vitreous" rel="me" class="sl-flex">
	<span class="sr-only">NuGet</span>
	<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
		<circle cx="5" cy="5" r="3" />
		<path d="M11 6h6a6 6 0 0 1 6 6v6a6 6 0 0 1-6 6h-6a6 6 0 0 1-6-6v-6a6 6 0 0 1 6-6Zm0.5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm5 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" fill-rule="evenodd" />
	</svg>
</a>
<Default><slot /></Default>

<style>
	a {
		color: var(--sl-color-text-accent);
		padding: 0.5em;
		margin: -0.5em;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	svg {
		width: 1rem;
		height: 1rem;
	}
</style>
