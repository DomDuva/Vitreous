<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Vitreous.Sample.Aot</RootNamespace>
    <AssemblyName>Vitreous.Sample.Aot</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vitreous/Vitreous.csproj" />
    <ProjectReference Include="../../src/Vitreous.SourceGeneration/Vitreous.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Vitreous.Caching/Vitreous.Caching.csproj" />
  </ItemGroup>

</Project>
