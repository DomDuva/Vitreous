<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One build per runtime so BenchmarkDotNet can run them side by side
      (run.sh passes the runtimes option with net10.0 and net11.0).
    -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Vitreous.Benchmarks</RootNamespace>
    <AssemblyName>Vitreous.Benchmarks</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Benchmarks are not production code; skip style enforcement -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- BenchmarkDotNet needs Release builds to be meaningful -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Vitreous library -->
    <ProjectReference Include="..\..\src\Vitreous\Vitreous.csproj" />
    <!--
      Source generator: runs at compile time, discovers all ICommandHandler /
      IQueryHandler / INotificationHandler types in this project and emits
      VitreousDispatcher.g.cs + VitreousServiceCollectionExtensions.g.cs.
      ReferenceOutputAssembly=false means it is not a runtime dependency.
    -->
    <ProjectReference Include="..\..\src\Vitreous.SourceGeneration\Vitreous.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
